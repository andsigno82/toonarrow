{
  "name": "toonarrow",
  "version": "0.1.0",
  "description": "The open-source, multi-CLI alternative to Fermat's Last Token: a local context-compression proxy for Claude Code, Codex, OpenCode and Kora",
  "license": "Apache-2.0",
  "author": "Andrea <andsigno82@gmail.com>",
  "homepage": "https://andsigno82.github.io/toonarrow/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andsigno82/toonarrow.git"
  },
  "bugs": "https://github.com/andsigno82/toonarrow/issues",
  "keywords": [
    "claude-code",
    "codex",
    "opencode",
    "kora",
    "llm",
    "proxy",
    "tokens",
    "context-compression",
    "prompt-caching",
    "mcp"
  ],
  "type": "module",
  "bin": {
    "toonarrow": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "serve": "node src/cli.ts serve",
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "zod": "^4.6.7"
  }
}
